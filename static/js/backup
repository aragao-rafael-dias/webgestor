async function sincronizarComSete() {
    const btn = document.getElementById('btn-sync-sete');
    const textoOriginal = btn.innerHTML;
    
    btn.innerHTML = '⏳ Sincronizando com Gov. Federal...';
    btn.disabled = true;
    btn.style.background = '#9e9e9e';

    try {
        const data = await apiFetch('/api/integracao/sincronizar', 'POST');
        if(data.sucesso) {
            tocarBip('resposta');
            alert(data.mensagem);
            console.log("DADOS IMPORTADOS DO SETE:", data.dados);
        } else {
            alert("Falha na sincronização: " + data.erro);
        }
    } catch (error) {
        console.error("Erro crítico:", error);
        alert("Erro ao tentar conectar com a API.");
    } finally {
        btn.innerHTML = textoOriginal;
        btn.disabled = false;
        btn.style.background = '#2196f3';
    }
}