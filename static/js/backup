window.dicionarioEscolas = {};
window.dadosRotas = null; // Guardará os dados originais das rotas para o filtro
let rotasLayerGroup = null; // A camada do mapa

// ⚠️ COLOQUE AQUI AS CORES EXATAS QUE VOCÊ SOLICITOU
const coresRegioes = {
    "1": "#4CAF50", // Verde
    "2": "#3182BD", // Azul
    "3": "#DE2D26", // Vermelho
    "4": "#FFEB3B", // Amarelo
    "5": "#9B4D96", // Rosa/Magenta
    "6": "#ED8936", // Laranja
    "7": "#5E2D79"  // Roxo
};

const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

function tocarBip(tipo) {
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    
    const now = audioCtx.currentTime;
    gain.gain.setValueAtTime(0.1, now);

    if (tipo === 'nova') {
        osc.type = 'sine';
        osc.frequency.setValueAtTime(880, now); 
        gain.gain.exponentialRampToValueAtTime(0.00001, now + 0.3);
        osc.start(now); osc.stop(now + 0.3);
    } else if (tipo === 'resposta') {
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(523.25, now); 
        osc.frequency.setValueAtTime(659.25, now + 0.1); 
        gain.gain.exponentialRampToValueAtTime(0.00001, now + 0.4);
        osc.start(now); osc.stop(now + 0.4);
    }
}

async function apiFetch(url, method = 'GET', body = null) {
    const options = { method, headers: { 'Content-Type': 'application/json' } };
    if (body) options.body = JSON.stringify(body);
    const res = await fetch(url, options);
    if (!res.ok) throw new Error(`Erro API: ${res.status}`);
    return res.json();
}

// Extrai inteligentemente apenas o NÚMERO da região (Ex: "Região 1" vira "1")
function obterIdRegiao(props) {
    const regiaoBruta = props.regiao || props.REGIAO || props.Regiao || props.região || props.Região || '';
    const match = String(regiaoBruta).match(/\d+/);
    return match ? match[0] : String(regiaoBruta).trim();
}

async function carregarMapa() {
    try {
        const [escolas, rotas] = await Promise.all([
            apiFetch('/api/escolas'),
            apiFetch('/api/rotas')
        ]);

        // Carrega Escolas (Mantido igual)
        L.geoJSON(escolas, {
            pointToLayer: function (feature, latlng) {
                return L.circleMarker(latlng, {
                    radius: 8, fillColor: "#ffff00", color: "#800000", weight: 2, opacity: 1, fillOpacity: 0.8
                });
            },
            onEachFeature: function (feature, layer) {
                const props = feature.properties;
                const nomeEscola = props.nome || props.NOME || 'Sem Nome Definido';
                const idEscola = feature.id || props.id || props.ID || props.gid;

                window.dicionarioEscolas[idEscola] = nomeEscola;

                layer.bindTooltip(`<strong>${nomeEscola}</strong>`, { direction: 'top' });
                layer.on('click', () => abrirFichaEscola(idEscola, nomeEscola, props));
            }
        }).addTo(map);

        // Salva os dados brutos e renderiza o filtro e as rotas
        window.dadosRotas = rotas;
        criarFiltroRegioes(); 
        renderizarRotas(); // Chama a função que desenha as rotas no mapa
        carregarVisaoGeral();
    } catch (e) {
        console.error("Erro ao carregar o mapa:", e);
    }
}

// ==========================================
// FUNÇÕES DE FILTRO E RENDERIZAÇÃO
// ==========================================

function renderizarRotas() {
    if (!window.dadosRotas) return;

    // Se já existe uma camada de rotas desenhada, remove ela do mapa antes de redesenhar
    if (rotasLayerGroup) {
        map.removeLayer(rotasLayerGroup);
    }

    // Pega as regiões que estão marcadas no filtro
    const checkboxesAtivos = document.querySelectorAll('.filtro-regiao:checked');
    const regioesPermitidas = Array.from(checkboxesAtivos).map(cb => cb.value);

    // Desenha as rotas nativamente usando o filtro do Leaflet
    rotasLayerGroup = L.geoJSON(window.dadosRotas, {
        filter: function (feature) {
            const regiaoId = obterIdRegiao(feature.properties);
            return regioesPermitidas.includes(regiaoId); // Só desenha se a região estiver permitida
        },
        style: function (feature) {
            const regiaoId = obterIdRegiao(feature.properties);
            const cor = coresRegioes[regiaoId] || "#800000"; // Se não achar a cor, usa vinho
            return { color: cor, weight: 4, opacity: 0.8, lineJoin: 'round' };
        },
        onEachFeature: function (feature, layer) {
            const props = feature.properties;
            const nomeRota = props.nome_rota || props.NOME_ROTA || 'Sem Identificação';
            const regiaoId = obterIdRegiao(props);
            const regiaoTexto = props.regiao || props.REGIAO || regiaoId;
            const trecho = props.trecho || props.TRECHO || 'Não Informado';
            const totalPontos = props.total_pontos || props.TOTAL_PONTOS || 0;
            const idRota = feature.id || props.id || props.ID || props.gid || props.GID;
            
            const corBase = coresRegioes[regiaoId] || "#800000";

            const popupContent = `
                <div style="font-family: Arial, sans-serif; min-width: 220px;">
                    <h4 style="margin: 0 0 8px 0; color: #800000; border-bottom: 2px solid #800000; padding-bottom:3px;">
                        🚌 ${nomeRota}
                    </h4>
                    <p style="margin: 4px 0; font-size: 13px;"><strong>📍 Região:</strong> ${regiaoTexto}</p>
                    <p style="margin: 4px 0; font-size: 13px;"><strong>🛤️ Trecho:</strong> ${trecho}</p>
                    <p style="margin: 4px 0; font-size: 13px;"><strong>🛑 Vértices:</strong> ${totalPontos}</p>
                    <button onclick="gerarMemorial(${idRota})" style="width: 100%; margin-top: 12px; background: #800000; color: white; border: none; padding: 8px; border-radius: 4px; cursor: pointer; font-weight: bold;">
                        📄 Gerar Memorial (PDF)
                    </button>
                </div>
            `;

            layer.bindPopup(popupContent);
            layer.on({
                mouseover: (e) => e.target.setStyle({ weight: 7, color: "#ffff00", opacity: 1 }),
                mouseout: (e) => e.target.setStyle({ weight: 4, color: corBase, opacity: 0.8 })
            });
        }
    }).addTo(map);
}

function criarFiltroRegioes() {
    if (document.getElementById('filtro-regioes-container')) return; 

    const container = document.createElement('div');
    container.id = 'filtro-regioes-container';
    container.style.padding = '10px';
    container.style.marginBottom = '15px';
    container.style.background = '#f9f9f9';
    container.style.border = '1px solid #ddd';
    container.style.borderRadius = '5px';

    const titulo = document.createElement('h4');
    titulo.innerText = '🗺️ Filtrar por Região';
    titulo.style.margin = '0 0 10px 0';
    titulo.style.color = '#800000';
    titulo.style.borderBottom = '2px solid #800000';
    titulo.style.paddingBottom = '3px';
    container.appendChild(titulo);

    Object.keys(coresRegioes).forEach(regiaoId => {
        const cor = coresRegioes[regiaoId];
        const label = document.createElement('label');
        label.style.display = 'block';
        label.style.marginBottom = '5px';
        label.style.cursor = 'pointer';
        label.style.fontSize = '14px';

        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.className = 'filtro-regiao';
        checkbox.value = regiaoId;
        checkbox.checked = true;
        // Quando qualquer checkbox for clicado, ele chama a função para redesenhar o mapa
        checkbox.addEventListener('change', renderizarRotas); 

        const iconeCor = document.createElement('span');
        iconeCor.innerHTML = ' &#9632; '; 
        iconeCor.style.color = cor;
        if (regiaoId === "4") iconeCor.style.textShadow = '1px 1px 1px #888'; 

        label.appendChild(checkbox);
        label.appendChild(iconeCor);
        label.appendChild(document.createTextNode(` Região ${regiaoId}`));
        container.appendChild(label);
    });

    const painelInfo = document.getElementById('info-escola');
    if (painelInfo && painelInfo.parentNode) {
        painelInfo.parentNode.insertBefore(container, painelInfo);
    }
}

