}

async function carregarRequisicoes(escolaId) {
    const statusEl = document.getElementById('status-requisicoes');
    statusEl.innerHTML = "<em>Buscando requisições...</em>";

    try {
        const data = await apiFetch(`/api/escolas/${escolaId}/requisicoes`);
        
        if (data.length === 0) {
            statusEl.innerHTML = "<p>Nenhuma requisição encontrada nesta unidade de ensino.</p>";
            return;
        }

        const pendentes = data.filter(req => req.status === 'Pendente');
        const respondidas = data.filter(req => req.status === 'Respondida');

        let html = `
        <details open style="margin-bottom: 10px;">
            <summary style="cursor: pointer; font-weight: bold; background: #ffff00; color: #800000; padding: 8px; border-radius: 5px;">
                🚨 PENDENTES (${pendentes.length})
            </summary>
            <div style="padding: 10px; border: 1px solid #ccc; border-top: none; background: #fff;">
        `;

        if (pendentes.length === 0) html += "<p>Nenhuma requisição pendente</p>";

        pendentes.forEach(req => {
            html += `
                <div style="margin-bottom: 15px; border-bottom: 1px dashed #ccc; padding-bottom:10px;">
                    <strong style="color: #d32f2f;"> Req #${req.id}</strong><br>
                    <p style="margin: 5px 0;"><em>"${req.descricao}"</em></p>
                    <textarea id="resposta-req-${req.id}" rows="2" style="width: 100%; margin-top:5px" placeholder="Digite a resposta da SEMED..."></textarea>
                    <button style="margin-top: 5px; cursor: pointer; background: #4caf50; color:white; border:none; padding: 5px 10px; border-radius:3px;"
                            onclick="responderRequisicao(${req.id}, ${escolaId})">
                        Responder e Concluir
                    </button>
                </div>
            `;
        });
        html += `</div></details>`;

        html += `
        <details style="margin-bottom:10px;">
            <summary style="cursor:pointer; font-weight: bold; background:#c8e6c9; padding:8px; border-radius:5px;">
                ✅ RESPONDIDAS (${respondidas.length})
            </summary>
            <div style="padding:10px; border: 1px solid #ccc; border-top: none; background: #fff;">
        `;
        
        if (respondidas.length === 0) html += "<p>Nenhuma requisição finalizada.</p>";

        respondidas.forEach(req => {
            html += `
                <div style="margin-bottom:10px; border-bottom: 1px dashed #ccc; padding-bottom: 10px;">
                    <strong style="color: #388e3c;">Req #${req.id}</strong><br>
                    <p style="margin: 5px 0;"><strong>Pedido:</strong> <em>"${req.descricao}"</em></p>
                    <p style="margin: 5px 0; color: #800000;"><strong>Resposta SEMED:</strong> ${req.resposta_semed}</p>
                </div>
            `;
        });
        html += `</div></details>`;

        statusEl.innerHTML = html;
    } catch (error) {
        statusEl.innerHTML = "<p style='color: red;'>Erro ao carregar histórico.</p>";
    }
}

async function novaRequisicao(escolaId, nomeEscola) {
    const textarea = document.getElementById(`texto-nova-req-${escolaId}`);
    const descricao = textarea.value.trim();
    if (!descricao) return;

    try {
        await apiFetch('/api/requisicoes', 'POST', { escola_id: escolaId, descricao: descricao });
        tocarBip('nova');
        textarea.value = '';
        carregarRequisicoes(escolaId);
    } catch (error) {
        alert("Ocorreu um erro ao salvar a requisição!");
    }
}

async function responderRequisicao(reqId, escolaId) {
    const textarea = document.getElementById(`resposta-req-${reqId}`);
    const resposta = textarea.value.trim();
    if (!resposta) return alert("A resposta não pode ficar vazia.");

    try {
        await apiFetch(`/api/requisicoes/${reqId}/responder`, 'POST', { resposta: resposta });
        tocarBip('resposta');
        carregarRequisicoes(escolaId); 
    } catch (error) {
        alert("Ocorreu um erro ao enviar a resposta.");
    }
}

async function responderRequisicaoGeral(reqId) {
    const textarea = document.getElementById(`resposta-geral-req-${reqId}`);
    const resposta = textarea.value.trim();
    if (!resposta) return alert("A resposta não pode ficar vazia.");

    try {
        await apiFetch(`/api/requisicoes/${reqId}/responder`, 'POST', { resposta: resposta });
        tocarBip('resposta');
        carregarVisaoGeral();
    } catch (error) {
        alert("Ocorreu um erro ao enviar a resposta.");
    }
}

function gerarMemorial(rotaId) {
    tocarBip('resposta');
    window.open(`/api/rotas/${rotaId}/memorial`, '_blank');
}

async function carregarVisaoGeral() {
    const painel = document.getElementById('info-escola');
    painel.innerHTML = `<h3 style="text-align:center; color: #800000;">📊 Visão Geral da Rede</h3><p style="text-align:center;"><em>Carregando panorama...</em></p>`;

    try {
        const data = await apiFetch('/api/requisicoes/todas');
        
        const pendentes = data.filter(r => r.status === 'Pendente');
        const respondidas = data.filter(r => r.status === 'Respondida');
        const total = data.length;
        const pctPendentes = total === 0 ? 0 : (pendentes.length / total) * 100;
        
        let html = `
            <div style="text-align: center; margin-bottom: 20px;">
                <h3 style="margin-bottom: 5px;">Status Geral (${total} Requisições)</h3>
                <div style="
                    background: conic-gradient(#ffff00 0% ${pctPendentes}%, #4caf50 ${pctPendentes}% 100%);
                    width: 130px; height: 130px; border-radius: 50%; 
                    margin: 15px auto; border: 3px solid #eee;
                    box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
                </div>
                <div style="display: flex; justify-content: space-around; font-weight: bold; margin-top:10px;">
                    <span style="color: #800000;">🚨 ${pendentes.length} Pendentes</span>
                    <span style="color: #388e3c;">✅ ${respondidas.length} Respondidas</span>
                </div>
            </div>
            <hr>
            <div style="max-height: 400px; overflow-y: auto; padding-right:5px;">
        `;
        
        if (pendentes.length > 0) {
            html += `<h4 style="color:#800000;">Últimas Pendentes</h4>`;
            pendentes.forEach(req => {
                const nomeEscola = window.dicionarioEscolas[req.escola_id] || `Escola #${req.escola_id}`;
                html += `
                    <details style="margin-bottom: 8px;">
                        <summary style="background: #fff9c4; border-left: 4px solid #ffff00; padding: 8px; border-radius: 4px; font-size: 0.9em; cursor: pointer; list-style: none;">
                            <strong>${nomeEscola}</strong> (Req #${req.id})<br>
                            <em>"${req.descricao}"</em>
                        </summary>
                        <div style="padding: 10px; background: #fafafa; border: 1px solid #eee; border-top: none; margin-top: -2px;">
                            <textarea id="resposta-geral-req-${req.id}" rows="2" style="width: 100%; padding: 5px; box-sizing: border-box;" placeholder="Digite a resposta da SEMED..."></textarea>
                            <button style="margin-top: 5px; cursor: pointer; background: #4caf50; color:white; border:none; padding: 5px 10px; border-radius:3px;"
                                    onclick="responderRequisicaoGeral(${req.id})">
                                Responder e Concluir
                            </button>
                        </div>
                    </details>`;
            });
        }

        if (respondidas.length > 0) {
            html += `<h4 style="color:#388e3c; margin-top:15px;">Últimas Respondidas</h4>`;
            respondidas.forEach(req => {
                const nomeEscola = window.dicionarioEscolas[req.escola_id] || `Escola #${req.escola_id}`;
                html += `
                    <div style="background: #e8f5e9; border-left: 4px solid #4caf50; padding: 8px; margin-bottom: 8px; border-radius: 4px; font-size: 0.9em;">
                        <strong>${nomeEscola}</strong> (Req #${req.id})<br>
                        <span style="color:#800000">Resp: ${req.resposta_semed}</span>
                    </div>`;
            });
        }

        html += `</div>`;
        painel.innerHTML = html;
    } catch (error) {
        painel.innerHTML = "<p style='color: red; text-align:center;'>Erro ao carregar Dashboard.</p>";
    }
}

