        ✖ Fechar Ficha da Escola
    </button>
    <h3 style="color: #800000;">${nomeEscola}</h3>
    <p><strong>Diretor:</strong> ${diretorEscola}</p>
    <p><strong>Telefone:</strong> ${telefoneEscola}</p>
    
    <hr>
    <h4>Requisições</h4>
    <textarea id="texto-nova-req-${idEscola}" rows="3" style="width: 100%;border-radius:5px;padding:5px;" placeholder="Registre a sua requisição à SEMED aqui!"></textarea>
    <button class="btn-requisicao" onclick="novaRequisicao(${idEscola}, '${nomeEscola}')" style="width: 100%; margin-top: 5px; background: #4caf50; color: white; border: none; padding: 8px; cursor: pointer; border-radius: 4px; font-weight: bold;">
